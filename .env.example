# Database
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/office_stock_db"

# NextAuth
AUTH_SECRET="your-secret-key-min-32-chars-change-this"
AUTH_URL="http://localhost:3000"

# Optional: For production
NEXTAUTH_URL="https://your-domain.com"

# โฟลเดอร์เก็บไฟล์อัปโหลด (รูปสินค้า, PDF ใบเสนอราคา)
# ถ้าไม่ตั้งค่า จะใช้ ./var/uploads
# บน production ควรชี้ไปที่ path ถาวรนอกโฟลเดอร์โปรเจกต์ เพื่อไม่ให้ไฟล์หายตอน deploy ใหม่
# UPLOAD_DIR="/var/lib/officestock/uploads"
