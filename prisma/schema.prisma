generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String             @unique
  emailVerified DateTime?
  image         String?
  password      String?
  mustResetPassword Boolean        @default(false)
  role          Role               @default(STAFF)
  transactions  StockTransaction[]
  quotations    Quotation[]
  repairJobs        RepairJob[]
  repairAttachments RepairAttachment[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  MODERATOR
  STAFF
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Department {
  id           Int                @id @default(autoincrement())
  name         String             @unique
  transactions StockTransaction[]
  repairJobs   RepairJob[]
  createdAt    DateTime           @default(now())
}

model Product {
  id           Int                @id @default(autoincrement())
  code         String             @unique
  lotNo        String?
  name         String
  description  String?            @db.Text
  category     Category           @relation(fields: [categoryId], references: [id])
  categoryId   Int
  totalStock   Int                @default(0)
  minStock     Int                @default(5)
  location     String?
  unit         String?
  unitPrice    Decimal?           @db.Decimal(10, 2)
  image        String?
  isActive     Boolean            @default(true)
  transactions StockTransaction[]
  updatedAt    DateTime           @updatedAt
  createdAt    DateTime           @default(now())
}

model StockTransaction {
  id           Int         @id @default(autoincrement())
  product      Product     @relation(fields: [productId], references: [id])
  productId    Int
  type         TxType
  quantity     Int
  reason       String
  receiver     String?
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId Int?
  note         String?     @db.Text
  operator     User        @relation(fields: [operatorId], references: [id])
  operatorId   String
  createdAt    DateTime    @default(now())
}

enum TxType {
  IN
  OUT
}

model Quotation {
  id           Int       @id @default(autoincrement())
  qtNumber     String    @default("")
  supplierName String
  description  String?   @db.Text
  orderDate    DateTime
  receiveDate  DateTime?
  totalAmount  Decimal   @db.Decimal(10, 2)
  fileUrl      String
  fileName     String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum RepairType {
  INTERNAL
  EXTERNAL
}

enum RepairStatus {
  RECEIVED
  IN_PROGRESS
  DONE
  RETURNED
  CANCELLED
}

model Technician {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  phone     String?
  isActive  Boolean     @default(true)
  repairs   RepairJob[]
  createdAt DateTime    @default(now())
}

model DeviceType {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  isActive  Boolean     @default(true)
  repairs   RepairJob[]
  createdAt DateTime    @default(now())
}

model RepairJob {
  id            Int          @id @default(autoincrement())
  jobNumber     String       @unique
  type          RepairType

  department    Department?  @relation(fields: [departmentId], references: [id])
  departmentId  Int?

  customerName  String?
  customerPhone String?

  // Person actually holding the device, on both internal and external jobs.
  ownerName     String?
  ownerTel      String?

  deviceType    DeviceType?  @relation(fields: [deviceTypeId], references: [id])
  deviceTypeId  Int?

  deviceName    String
  deviceModel   String?
  serialNo      String?
  serviceTag    String?
  expressNo     String?
  problem       String       @db.Text

  partsUsed     String?      @db.Text
  partsCost     Decimal      @default(0) @db.Decimal(10, 2)
  labourCost    Decimal      @default(0) @db.Decimal(10, 2)
  totalCost     Decimal      @default(0) @db.Decimal(10, 2)

  status        RepairStatus @default(RECEIVED)
  technician    Technician?  @relation(fields: [technicianId], references: [id])
  technicianId  Int?

  createdBy     User         @relation(fields: [createdById], references: [id])
  createdById   String

  reportedAt    DateTime     @default(now())
  closedAt      DateTime?
  note          String?      @db.Text

  attachments   RepairAttachment[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([reportedAt])
}

model RepairAttachment {
  id           Int       @id @default(autoincrement())
  repairJob    RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  repairJobId  Int
  fileUrl      String
  fileName     String
  mimeType     String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime  @default(now())

  @@index([repairJobId])
}
